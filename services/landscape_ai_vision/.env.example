# Copy to .env and fill in. .env is git-ignored.

# Default: Claude on Amazon Bedrock, using your normal AWS credentials
# (an AWS profile, ~/.aws/credentials, or the EC2 instance role).
LAV_BACKEND=bedrock
LAV_AWS_REGION=us-east-2
LAV_AWS_PROFILE=lawn
# Run `python -m landscape_ai_vision.check_bedrock` to see which models work.
LAV_MODEL=anthropic.claude-sonnet-5-5

# Only if you use the Anthropic API directly instead (LAV_BACKEND=claude):
# ANTHROPIC_API_KEY=
